FROM fedora:44

# Instalar dependências básicas para o Ansible operar via docker connection
# (python3-libdnf5: o módulo package/dnf5 do Ansible precisa dele para instalar pacotes)
RUN dnf install -y --setopt=install_weak_deps=False \
        python3 \
        python3-libdnf5 \
        sudo \
        bash \
        shadow-utils \
        git \
        curl \
        ca-certificates && \
    dnf clean all

# Criar usuário não-root 'dev' com acesso sudo sem senha
RUN useradd -m -s /bin/bash dev && \
    echo "dev:dev" | chpasswd && \
    mkdir -p /etc/sudoers.d && \
    echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev && \
    chmod 0440 /etc/sudoers.d/dev

WORKDIR /home/dev
USER dev

CMD ["tail", "-f", "/dev/null"]
